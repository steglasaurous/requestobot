  "scripts": {
    "postinstall": "electron-builder install-app-deps && electron-builder install-app-deps",
    "typeorm": "ts-node -P ./apps/requestobot-server/tsconfig.app.json ./node_modules/typeorm/cli -d ./apps/requestobot-server/src/typeorm-cli.config.ts",
    "typeorm:run-migrations": "npm run typeorm migration:run",
    "typeorm:generate-migration": "npm run typeorm migration:generate ./apps/requestobot-server/src/migrations/migration",
    "typeorm:create-migration": "npm run typeorm migration:create ./apps/requestobot-server/src/migrations",
    "typeorm:revert-migration": "npm run typeorm migration:revert",
    "resetdb": "npm run typeorm schema:drop && npm run typeorm:run-migrations",
    "prepare": "husky"
  },
